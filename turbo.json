{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalEnv": [
		"DATABASE_URL",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"NEXT_PUBLIC_SITE_URL",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"MAIN_APP_URL",
		"ADMIN_APP_URL",
		"RESEND_API_KEY",
		"RESEND_FROM_EMAIL",
		"NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
		"NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET",
		"CLOUDINARY_API_KEY",
		"CLOUDINARY_API_SECRET",
		"R2_ACCOUNT_ID",
		"R2_ACCESS_KEY_ID",
		"R2_SECRET_ACCESS_KEY",
		"R2_BUCKET_NAME",
		"R2_PUBLIC_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"DATABASE_URL",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"NEXT_PUBLIC_SITE_URL",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"MAIN_APP_URL",
				"ADMIN_APP_URL",
				"RESEND_API_KEY",
				"RESEND_FROM_EMAIL",
				"NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
				"NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET",
				"CLOUDINARY_API_KEY",
				"CLOUDINARY_API_SECRET",
				"R2_ACCOUNT_ID",
				"R2_ACCESS_KEY_ID",
				"R2_SECRET_ACCESS_KEY",
				"R2_BUCKET_NAME",
				"R2_PUBLIC_URL"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
